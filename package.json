{
  "name": "zoku-website",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "description": "Zoku Holding & Participações — Institutional Website",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "build:clean": "rm -rf dist .astro && astro build",
    "deploy:check": "node scripts/deploy-ftp.mjs",
    "deploy": "node scripts/deploy-ftp.mjs --publish",
    "deploy:prune": "node scripts/deploy-ftp.mjs --publish --prune",
    "deploy:status": "node scripts/deploy-ftp.mjs --verify"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "tailwindcss": "^4.0.9"
  },
  "devDependencies": {
    "astro": "^5.4.1",
    "basic-ftp": "^5.0.5",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.3"
  }
}
